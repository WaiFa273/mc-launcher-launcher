<UserControl x:Class="LauncherLauncher.Views.ChainPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="26,22,26,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  标题  -->
        <Grid Grid.Row="0">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Text.H1}" Text="启动器接力" />
                    <Border Margin="10,0,0,0" Padding="8,2" VerticalAlignment="Center" CornerRadius="6"
                            Background="{StaticResource Brush.AccentSoft}">
                        <TextBlock FontSize="11" Foreground="{StaticResource Brush.Accent}" Text="套娃模式" />
                    </Border>
                </StackPanel>
                <TextBlock x:Name="SubtitleText" Margin="0,6,0,0" Style="{StaticResource Text.Secondary}"
                           Text="让一个启动器启动另一个启动器，直到你忘了最初想玩什么。" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                <Button Style="{StaticResource Btn.Primary}" Content="新建接力" Click="New_Click" />
            </StackPanel>
        </Grid>

        <!--  运行横幅  -->
        <Border x:Name="RunningBanner" Grid.Row="1" Margin="0,14,0,0" Padding="14,10" CornerRadius="10"
                Background="{StaticResource Brush.AccentSoft}" Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center" FontFamily="{StaticResource Font.Icons}" FontSize="15"
                           Foreground="{StaticResource Brush.Accent}" Text="&#xE768;" />
                <StackPanel Grid.Column="1" Margin="10,0,10,0" VerticalAlignment="Center">
                    <TextBlock x:Name="RunningTitle" FontSize="12.5" FontWeight="SemiBold"
                               Foreground="{StaticResource Brush.Accent}" Text="接力进行中" />
                    <TextBlock x:Name="RunningDetail" Margin="0,2,0,0" FontSize="11.5"
                               Foreground="{StaticResource Brush.TextSecondary}" Text="" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Button x:Name="StopBtn" Grid.Column="2" Style="{StaticResource Btn.Secondary.Small}" Content="停止接力"
                        Click="Stop_Click" />
            </Grid>
        </Border>

        <!--  列表  -->
        <Grid Grid.Row="2" Margin="0,14,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="ChainList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Padding="16,14" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border Width="42" Height="42" CornerRadius="11" Background="{StaticResource Brush.AccentSoft}"
                                            VerticalAlignment="Top">
                                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="17"
                                                   FontFamily="{StaticResource Font.Icons}"
                                                   Foreground="{StaticResource Brush.Accent}" Text="&#xE71B;" />
                                    </Border>

                                    <StackPanel Grid.Column="1" Margin="14,0,12,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock FontSize="14" FontWeight="SemiBold" Text="{Binding Name}" />
                                            <Border Margin="8,0,0,0" Padding="7,1" VerticalAlignment="Center" CornerRadius="5"
                                                    Background="{StaticResource Brush.Muted}">
                                                <TextBlock FontSize="10.5" Text="{Binding ModeText}"
                                                           Foreground="{StaticResource Brush.TextSecondary}" />
                                            </Border>
                                            <Border Margin="6,0,0,0" Padding="7,1" VerticalAlignment="Center" CornerRadius="5"
                                                    Background="{StaticResource Brush.Muted}">
                                                <TextBlock FontSize="10.5" Text="{Binding CountText}"
                                                           Foreground="{StaticResource Brush.TextSecondary}" />
                                            </Border>
                                        </StackPanel>

                                        <TextBlock Margin="0,7,0,0" FontSize="11.5" Text="{Binding StepsText}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{StaticResource Brush.TextTertiary}" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Style="{StaticResource Btn.Primary.Small}" Content="开始接力" Tag="{Binding}"
                                                Click="Run_Click" />
                                        <Button Margin="6,0,0,0" Style="{StaticResource Btn.Secondary.Small}" Content="编辑"
                                                Tag="{Binding}" Click="Edit_Click" />
                                        <Button Margin="6,0,0,0" Style="{StaticResource Btn.Ghost}" Content="&#xE74D;"
                                                ToolTip="删除这条接力" FontFamily="{StaticResource Font.Icons}" FontSize="12"
                                                Foreground="{StaticResource Brush.TextTertiary}" Tag="{Binding}"
                                                Click="Delete_Click" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                <Border Width="72" Height="72" CornerRadius="36" Background="{StaticResource Brush.AccentSoft}"
                        HorizontalAlignment="Center">
                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="{StaticResource Font.Icons}"
                               FontSize="30" Foreground="{StaticResource Brush.Accent}" Text="&#xE71B;" />
                </Border>
                <TextBlock x:Name="EmptyTitle" Margin="0,16,0,0" HorizontalAlignment="Center" Style="{StaticResource Text.H2}"
                           Text="还没有排过接力" />
                <TextBlock x:Name="EmptyText" Margin="0,8,0,0" HorizontalAlignment="Center" MaxWidth="380"
                           TextAlignment="Center" TextWrapping="Wrap" FontSize="12.5" LineHeight="21"
                           Foreground="{StaticResource Brush.TextSecondary}"
                           Text="接力能让一个启动器启动另一个启动器。虽然它们大概率不会承认这件事。" />
                <Button Margin="0,16,0,0" HorizontalAlignment="Center" Style="{StaticResource Btn.Primary}"
                        Content="新建接力" Click="New_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
