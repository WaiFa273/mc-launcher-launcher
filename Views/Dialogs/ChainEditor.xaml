<UserControl x:Class="LauncherLauncher.Views.Dialogs.ChainEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="600">
    <Grid Margin="26,22,26,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <Border Width="38" Height="38" CornerRadius="19" Background="{StaticResource Brush.AccentSoft}" VerticalAlignment="Top">
                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="{StaticResource Font.Icons}"
                           FontSize="17" Foreground="{StaticResource Brush.Accent}" Text="&#xE71B;" />
            </Border>
            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                <TextBlock x:Name="TitleText" Style="{StaticResource Text.H2}" Text="新的接力" />
                <TextBlock Margin="0,4,0,0" Style="{StaticResource Text.Caption}"
                           Text="把启动器排好队，让它们一个接一个出场。" />
            </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,18,0,0">
            <TextBlock Style="{StaticResource Text.Caption}" Text="接力名称" />
            <TextBox x:Name="NameBox" Margin="0,6,0,0" Height="34" Style="{StaticResource Input}" />

            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource Text.Caption}" Text="启动方式" />
                    <StackPanel Margin="0,6,0,0" Orientation="Horizontal">
                        <RadioButton x:Name="ModeWait" Style="{StaticResource Seg}" Content="等上一个退出" GroupName="chainMode"
                                     Checked="Mode_Checked" />
                        <RadioButton x:Name="ModeSim" Style="{StaticResource Seg}" Content="同时启动" GroupName="chainMode"
                                     Checked="Mode_Checked" />
                        <RadioButton x:Name="ModeDelay" Style="{StaticResource Seg}" Content="间隔启动" GroupName="chainMode"
                                     Checked="Mode_Checked" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="16,0,0,0" Width="110">
                    <TextBlock Style="{StaticResource Text.Caption}" Text="间隔（毫秒）" />
                    <TextBox x:Name="DelayBox" Margin="0,6,0,0" Height="34" Style="{StaticResource Input}" Text="900"
                             IsEnabled="False" />
                </StackPanel>
            </Grid>
        </StackPanel>

        <Border Grid.Row="2" Margin="0,16,0,0" CornerRadius="10" Background="{StaticResource Brush.Muted}" MinHeight="150">
            <Grid Margin="10">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="StepList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,4" Padding="10,7" CornerRadius="8" Background="{StaticResource Brush.Card}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Border Width="22" Height="22" CornerRadius="6" Background="{StaticResource Brush.AccentSoft}"
                                                VerticalAlignment="Center">
                                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11"
                                                       FontWeight="SemiBold" Text="{Binding Index}"
                                                       Foreground="{StaticResource Brush.Accent}" />
                                        </Border>

                                        <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                                            <TextBlock FontSize="12.5" FontWeight="SemiBold" Text="{Binding Name}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Margin="0,2,0,0" FontSize="11" Text="{Binding Path}"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{StaticResource Brush.TextTertiary}" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                                            <Button Style="{StaticResource Btn.Icon}" ToolTip="上移" Tag="{Binding}"
                                                    Click="Up_Click">
                                                <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE74A;" />
                                            </Button>
                                            <Button Style="{StaticResource Btn.Icon}" ToolTip="下移" Tag="{Binding}"
                                                    Click="Down_Click">
                                                <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE74B;" />
                                            </Button>
                                            <Button Style="{StaticResource Btn.Icon}" ToolTip="移除" Tag="{Binding}"
                                                    Click="Remove_Click">
                                                <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE74D;"
                                                           Foreground="{StaticResource Brush.Danger}" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <TextBlock x:Name="EmptySteps" Text="还没有步骤。接力总得有人先跑第一棒。" VerticalAlignment="Center"
                           HorizontalAlignment="Center" FontSize="12"
                           Foreground="{StaticResource Brush.TextTertiary}" />
            </Grid>
        </Border>

        <Grid Grid.Row="3" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <ComboBox x:Name="PickBox" Width="200" Height="32" VerticalContentAlignment="Center" />
                <Button Margin="8,0,0,0" Style="{StaticResource Btn.Secondary.Small}" Content="添加步骤" Click="AddStep_Click" />
                <TextBlock x:Name="ErrorText" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="11.5"
                           TextWrapping="Wrap" Foreground="{StaticResource Brush.Danger}" Visibility="Collapsed" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Style="{StaticResource Btn.Secondary}" Content="取消" Click="Cancel_Click" />
                <Button Style="{StaticResource Btn.Primary}" Content="保存" Click="Save_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
