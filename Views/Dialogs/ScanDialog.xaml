<UserControl x:Class="LauncherLauncher.Views.Dialogs.ScanDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="640">
    <Grid Margin="26,22,26,22">

        <!--  扫描中  -->
        <StackPanel x:Name="ScanningPanel">
            <StackPanel Orientation="Horizontal">
                <Border Width="38" Height="38" CornerRadius="19" Background="{StaticResource Brush.AccentSoft}" VerticalAlignment="Top">
                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="{StaticResource Font.Icons}"
                               FontSize="17" Foreground="{StaticResource Brush.Accent}" Text="&#xE721;" />
                </Border>
                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource Text.H2}" Text="正在扫描本机" />
                    <TextBlock x:Name="ProgressText" Margin="0,4,0,0" Style="{StaticResource Text.Caption}"
                               Text="正在翻你的硬盘，看看藏了多少启动器…" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </StackPanel>

            <ProgressBar x:Name="Bar" Height="6" Margin="0,18,0,0" IsIndeterminate="True"
                         Foreground="{StaticResource Brush.Accent}" Background="{StaticResource Brush.Muted}"
                         BorderThickness="0" />

            <TextBlock Margin="0,12,0,0" FontSize="11.5" LineHeight="19" TextWrapping="Wrap"
                       Foreground="{StaticResource Brush.TextTertiary}"
                       Text="扫描只在本机进行，结果不会上传。这一点比某些启动器强。" />

            <StackPanel Margin="0,16,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource Btn.Secondary}" Content="取消扫描" Click="Cancel_Click" />
            </StackPanel>
        </StackPanel>

        <!--  结果  -->
        <Grid x:Name="ResultPanel" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <TextBlock x:Name="ResultTitle" Style="{StaticResource Text.H2}" Text="扫描完成" />
                <TextBlock x:Name="ResultSubtitle" Margin="0,5,0,0" Style="{StaticResource Text.Caption}"
                           Text="勾选你想收进列表的启动器。" />
            </StackPanel>

            <Border Grid.Row="1" Margin="0,14,0,0" MaxHeight="330" Style="{StaticResource Card.Flat}"
                    BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" CornerRadius="10">
                <Grid>
                    <ScrollViewer x:Name="ResultScroll" VerticalScrollBarVisibility="Auto" Margin="4">
                        <ItemsControl x:Name="ResultList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="8,7" Margin="0,0,0,2" CornerRadius="7" Background="Transparent">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <CheckBox Margin="0,2,0,0" VerticalAlignment="Top" Style="{StaticResource Check}"
                                                      IsChecked="{Binding IsChecked, Mode=TwoWay}" />
                                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock FontSize="13" FontWeight="SemiBold" Text="{Binding Name}" />
                                                    <Border Margin="8,0,0,0" Padding="6,1" VerticalAlignment="Center" CornerRadius="5"
                                                            Background="{StaticResource Brush.Muted}">
                                                        <TextBlock FontSize="10" Text="{Binding Reason}"
                                                                   Foreground="{StaticResource Brush.TextTertiary}" />
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Margin="0,3,0,0" FontSize="11" Text="{Binding Path}"
                                                           TextTrimming="CharacterEllipsis"
                                                           Foreground="{StaticResource Brush.TextTertiary}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <TextBlock x:Name="NoSelectionHint" Text="没有勾选任何启动器" VerticalAlignment="Center"
                               HorizontalAlignment="Center" FontSize="12"
                               Foreground="{StaticResource Brush.TextTertiary}" Visibility="Collapsed" />
                </Grid>
            </Border>

            <Grid Grid.Row="2" Margin="0,16,0,0">
                <CheckBox x:Name="SelectAll" Style="{StaticResource Check}" Content="全选"
                          VerticalAlignment="Center" Checked="SelectAll_Changed" Unchecked="SelectAll_Changed" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource Btn.Secondary}" Content="扫描取消" Click="Cancel_Click" />
                    <Button x:Name="AddBtn" Margin="8,0,0,0" Style="{StaticResource Btn.Primary}"
                            Content="添加选中" Click="Add_Click" />
                </StackPanel>
            </Grid>
        </Grid>

        <!--  空结果  -->
        <StackPanel x:Name="EmptyPanel" Visibility="Collapsed">
            <StackPanel Orientation="Horizontal">
                <Border Width="38" Height="38" CornerRadius="19" Background="{StaticResource Brush.WarnSoft}" VerticalAlignment="Top">
                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="{StaticResource Font.Icons}"
                               FontSize="17" Foreground="{StaticResource Brush.Warn}" Text="&#xE7BA;" />
                </Border>
                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource Text.H2}" Text="一个都没找到" />
                    <TextBlock Margin="0,4,0,0" Style="{StaticResource Text.Caption}"
                               Text="要么你的启动器藏得太深，要么你真的很克制。" />
                </StackPanel>
            </StackPanel>

            <TextBlock x:Name="EmptyText" Margin="0,16,0,0" FontSize="12.5" LineHeight="21" TextWrapping="Wrap"
                       Foreground="{StaticResource Brush.TextSecondary}"
                       Text="那就手动添加吧。毕竟这软件的存在意义，就是帮你记住你把启动器放在了哪里。" />

            <StackPanel Margin="0,18,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource Btn.Secondary}" Content="关闭" Click="Cancel_Click" />
                <Button Margin="8,0,0,0" Style="{StaticResource Btn.Primary}" Content="再扫一次" Click="Rescan_Click" />
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
