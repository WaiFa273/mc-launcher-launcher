<UserControl x:Class="LauncherLauncher.Views.Dialogs.EntryEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="560">
    <StackPanel Margin="26,22,26,22">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock x:Name="TitleText" Style="{StaticResource Text.H2}" Text="添加一个启动器" />
                <TextBlock x:Name="SubtitleText" Margin="0,5,0,0" Style="{StaticResource Text.Caption}"
                           Text="把别的启动器交给我，我负责启动它们。" />
            </StackPanel>
            <Border Grid.Column="1" Width="44" Height="44" CornerRadius="11" VerticalAlignment="Top"
                    Background="{StaticResource Brush.Muted}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1">
                <Grid>
                    <TextBlock x:Name="FallbackIcon" FontSize="19" HorizontalAlignment="Center"
                               VerticalAlignment="Center" Foreground="{StaticResource Brush.TextTertiary}" Text="?" />
                    <Image x:Name="PreviewIcon" Width="28" Height="28" Visibility="Collapsed"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                </Grid>
            </Border>
        </Grid>

        <TextBlock Margin="0,18,0,6" Style="{StaticResource Text.Caption}" Text="名称" />
        <TextBox x:Name="NameBox" Height="36" Style="{StaticResource Input}" />

        <TextBlock Margin="0,14,0,6" Style="{StaticResource Text.Caption}" Text="程序路径" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="PathBox" Grid.Column="0" Height="36" Style="{StaticResource Input}"
                     TextChanged="PathBox_TextChanged" />
            <Button Grid.Column="1" Margin="8,0,0,0" Style="{StaticResource Btn.Secondary}" Content="浏览…" Click="BrowseFile_Click" />
            <Button Grid.Column="2" Margin="8,0,0,0" Width="36" Padding="0" Style="{StaticResource Btn.Icon}"
                    Click="Reveal_Click" ToolTip="在文件夹中显示">
                <TextBlock FontFamily="{StaticResource Font.Icons}" FontSize="13" Text="&#xE838;" />
            </Button>
        </Grid>

        <StackPanel Margin="0,14,0,0" Orientation="Horizontal">
            <StackPanel Width="200">
                <TextBlock Margin="0,0,0,6" Style="{StaticResource Text.Caption}" Text="启动参数（可选）" />
                <TextBox x:Name="ArgsBox" Height="36" Style="{StaticResource Input}" />
            </StackPanel>
            <StackPanel Width="190" Margin="12,0,0,0">
                <TextBlock Margin="0,0,0,6" Style="{StaticResource Text.Caption}" Text="工作目录（可选）" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="DirBox" Grid.Column="0" Height="36" Style="{StaticResource Input}" />
                    <Button Grid.Column="1" Margin="6,0,0,0" Width="36" Padding="0" Style="{StaticResource Btn.Icon}"
                            Click="BrowseDir_Click" ToolTip="选择目录">
                        <TextBlock FontFamily="{StaticResource Font.Icons}" FontSize="12" Text="&#xE8B7;" />
                    </Button>
                </Grid>
            </StackPanel>
            <StackPanel Width="130" Margin="12,0,0,0">
                <TextBlock Margin="0,0,0,6" Style="{StaticResource Text.Caption}" Text="标签（可选）" />
                <TextBox x:Name="TagsBox" Height="36" Style="{StaticResource Input}" ToolTip="用逗号或空格分隔" />
            </StackPanel>
        </StackPanel>

        <TextBlock Margin="0,14,0,6" Style="{StaticResource Text.Caption}" Text="备注（可选）" />
        <TextBox x:Name="NotesBox" Height="62" Style="{StaticResource Input}" AcceptsReturn="True"
                 TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />

        <CheckBox x:Name="AdminCheck" Margin="0,14,0,0" Style="{StaticResource Check}"
                  Content="以管理员身份运行（会弹 UAC，很符合启动器的气质）" />

        <TextBlock x:Name="ErrorText" Margin="0,12,0,0" FontSize="11.5" Visibility="Collapsed"
                   Foreground="{StaticResource Brush.Danger}" TextWrapping="Wrap" />

        <StackPanel Margin="0,20,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Style="{StaticResource Btn.Secondary}" MinWidth="76" Content="取消" Click="Cancel_Click" />
            <Button Margin="8,0,0,0" Style="{StaticResource Btn.Primary}" MinWidth="96" Content="保存" Click="Save_Click" />
        </StackPanel>
    </StackPanel>
</UserControl>
