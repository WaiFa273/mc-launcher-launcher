<UserControl x:Class="LauncherLauncher.Views.Dialogs.ProgressRunDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="600">
    <Grid Margin="26,22,26,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <StackPanel Orientation="Horizontal">
                <Border Width="38" Height="38" CornerRadius="19" Background="{StaticResource Brush.AccentSoft}" VerticalAlignment="Top">
                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="{StaticResource Font.Icons}"
                               FontSize="17" Foreground="{StaticResource Brush.Accent}" Text="&#xE768;" />
                </Border>
                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="TitleText" Style="{StaticResource Text.H2}" Text="全部启动" />
                    <TextBlock x:Name="SubtitleText" Margin="0,4,0,0" Style="{StaticResource Text.Caption}" Text="正在启动启动器…" />
                </StackPanel>
            </StackPanel>

            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ProgressBar x:Name="Bar" Height="6" Minimum="0" Maximum="1" Value="0" VerticalAlignment="Center"
                             Foreground="{StaticResource Brush.Accent}" Background="{StaticResource Brush.Muted}"
                             BorderThickness="0" />
                <TextBlock x:Name="ProgressText" Grid.Column="1" Margin="10,0,0,0" FontSize="11.5" VerticalAlignment="Center"
                           Foreground="{StaticResource Brush.TextTertiary}" Text="0 / 0" />
            </Grid>
        </StackPanel>

        <Border Grid.Row="1" Margin="0,14,0,0" MaxHeight="320" CornerRadius="10" Background="{StaticResource Brush.Muted}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="6">
                <ItemsControl x:Name="RunList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="9,7" Margin="0,0,0,2" CornerRadius="7" Background="Transparent">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border Width="26" Height="26" CornerRadius="7" Background="{Binding BadgeBrush}" VerticalAlignment="Center">
                                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11"
                                                   FontFamily="{StaticResource Font.Icons}" Foreground="{Binding GlyphBrush}"
                                                   Text="{Binding Glyph}" />
                                    </Border>

                                    <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                                        <TextBlock FontSize="12.5" FontWeight="SemiBold" Text="{Binding Name}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Margin="0,2,0,0" FontSize="11" Text="{Binding Detail}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{StaticResource Brush.TextTertiary}" />
                                    </StackPanel>

                                    <TextBlock Grid.Column="2" VerticalAlignment="Center" FontSize="11.5" Text="{Binding Status}"
                                               Foreground="{Binding StatusBrush}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <Grid Grid.Row="2" Margin="0,14,0,0">
            <TextBlock x:Name="SummaryText" VerticalAlignment="Center" FontSize="12" TextWrapping="Wrap"
                       Foreground="{StaticResource Brush.TextSecondary}" Text="" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CancelBtn" Style="{StaticResource Btn.Secondary}" Content="取消" Click="Cancel_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
