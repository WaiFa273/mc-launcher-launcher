<UserControl x:Class="LauncherLauncher.Views.Dialogs.MessageDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="440">
    <StackPanel Margin="26,24,26,22">
        <StackPanel Orientation="Horizontal">
            <Border x:Name="IconBadge" Width="38" Height="38" CornerRadius="19"
                    Background="{StaticResource Brush.AccentSoft}" VerticalAlignment="Top">
                <TextBlock x:Name="IconGlyph" FontFamily="{StaticResource Font.Icons}" FontSize="17"
                           Foreground="{StaticResource Brush.Accent}" Text="&#xE946;"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                <TextBlock x:Name="TitleText" Style="{StaticResource Text.H2}" Text="标题" TextWrapping="Wrap" />
            </StackPanel>
        </StackPanel>

        <TextBlock x:Name="MessageText" Margin="0,14,0,0" LineHeight="21" TextWrapping="Wrap"
                   Foreground="{StaticResource Brush.TextSecondary}" FontSize="12.5" Text="消息" />

        <StackPanel Margin="0,22,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="CancelBtn" Style="{StaticResource Btn.Secondary}" MinWidth="76" Click="Cancel_Click" Content="取消" />
            <Button x:Name="SecondaryBtn" Margin="8,0,0,0" Style="{StaticResource Btn.Secondary}" MinWidth="76" Click="Secondary_Click" />
            <Button x:Name="PrimaryBtn" Margin="8,0,0,0" Style="{StaticResource Btn.Primary}" MinWidth="96" Click="Primary_Click" />
        </StackPanel>
    </StackPanel>
</UserControl>
