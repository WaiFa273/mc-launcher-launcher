<UserControl x:Class="LauncherLauncher.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="26,22,26,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource Text.H1}" Text="设置" />
                <Border Margin="10,0,0,0" Padding="8,2" VerticalAlignment="Center" CornerRadius="6"
                        Background="{StaticResource Brush.Muted}">
                    <TextBlock x:Name="VersionChip" FontSize="11" Foreground="{StaticResource Brush.TextSecondary}"
                               Text="套娃版" />
                </Border>
            </StackPanel>
            <TextBlock Margin="0,6,0,0" Style="{StaticResource Text.Secondary}"
                       Text="改完立刻生效。设置太多本身就是一种病，所以这里只有一页。" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" Margin="0,14,0,0" VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="760" HorizontalAlignment="Center">

                <!--  常规  -->
                <Border Style="{StaticResource Card}" Padding="18,16">
                    <StackPanel>
                        <TextBlock FontSize="14" FontWeight="SemiBold" Text="常规" />

                        <CheckBox x:Name="AutoScanCheck" Margin="0,14,0,0" Style="{StaticResource Check}"
                                  Content="启动时自动扫描本机启动器（只在列表为空时扫）" Checked="Setting_Changed" Unchecked="Setting_Changed" />
                        <CheckBox x:Name="DoubleClickCheck" Margin="0,12,0,0" Style="{StaticResource Check}"
                                  Content="双击卡片直接启动" Checked="Setting_Changed" Unchecked="Setting_Changed" />
                        <CheckBox x:Name="ShowPathCheck" Margin="0,12,0,0" Style="{StaticResource Check}"
                                  Content="在列表里显示完整路径" Checked="Setting_Changed" Unchecked="Setting_Changed" />
                        <CheckBox x:Name="SkipConfirmCheck" Margin="0,12,0,0" Style="{StaticResource Check}"
                                  Content="跳过确认弹窗（一键启动全部、删除等）" Checked="Setting_Changed" Unchecked="Setting_Changed" />
                    </StackPanel>
                </Border>

                <!--  启动行为  -->
                <Border Margin="0,12,0,0" Style="{StaticResource Card}" Padding="18,16">
                    <StackPanel>
                        <TextBlock FontSize="14" FontWeight="SemiBold" Text="启动行为" />

                        <CheckBox x:Name="SimCheck" Margin="0,14,0,0" Style="{StaticResource Check}"
                                  Content="一键启动全部时同时启动，而不是挨个来" Checked="Setting_Changed" Unchecked="Setting_Changed" />
                        <CheckBox x:Name="MinimizeAfterCheck" Margin="0,12,0,0" Style="{StaticResource Check}"
                                  Content="启动启动器之后，把自己最小化" Checked="Setting_Changed" Unchecked="Setting_Changed" />
                        <CheckBox x:Name="TrayCheck" Margin="0,12,0,0" Style="{StaticResource Check}"
                                  Content="点关闭时最小化到托盘，而不是退出" Checked="Setting_Changed" Unchecked="Setting_Changed" />
                        <CheckBox x:Name="AutoStartCheck" Margin="0,12,0,0" Style="{StaticResource Check}"
                                  Content="开机自动启动（让它比浏览器还勤快）" Checked="Setting_Changed" Unchecked="Setting_Changed" />

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource Text.Caption}" Text="逐个启动时的间隔（毫秒）" />
                                <TextBox x:Name="DelayBox" Margin="0,6,0,0" Width="180" Height="32" HorizontalAlignment="Left"
                                         Style="{StaticResource Input}" TextChanged="Delay_Changed" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Margin="12,20,0,0" VerticalAlignment="Center" FontSize="11"
                                       Foreground="{StaticResource Brush.TextTertiary}"
                                       Text="太短会卡，太长会显得很犹豫。" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!--  Java  -->
                <Border Margin="0,12,0,0" Style="{StaticResource Card}" Padding="18,16">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontSize="14" FontWeight="SemiBold" Text="Java" />
                            <TextBlock Margin="8,2,0,0" VerticalAlignment="Center" FontSize="11"
                                       Foreground="{StaticResource Brush.TextTertiary}"
                                       Text="只有 .jar 形式的启动器才用得上" />
                        </StackPanel>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="JavaBox" Height="32" Style="{StaticResource Input}"
                                     ToolTip="javaw.exe 或 java.exe 的路径，留空则自动寻找" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Margin="8,0,0,0" Style="{StaticResource Btn.Secondary.Small}" Content="浏览"
                                        Click="BrowseJava_Click" />
                                <Button Margin="6,0,0,0" Style="{StaticResource Btn.Secondary.Small}" Content="自动检测"
                                        Click="DetectJava_Click" />
                            </StackPanel>
                        </Grid>

                        <TextBlock x:Name="JavaHint" Margin="0,8,0,0" FontSize="11"
                                   Foreground="{StaticResource Brush.TextTertiary}" Text="" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!--  数据  -->
                <Border Margin="0,12,0,0" Style="{StaticResource Card}" Padding="18,16">
                    <StackPanel>
                        <TextBlock FontSize="14" FontWeight="SemiBold" Text="数据" />

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource Text.Caption}" Text="数据目录" />
                                <TextBox x:Name="DataBox" Margin="0,6,0,0" Height="32" IsReadOnly="True"
                                         Style="{StaticResource Input}" FontFamily="{StaticResource Font.Mono}" FontSize="11.5" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                                <Button Margin="8,0,0,0" Style="{StaticResource Btn.Secondary.Small}" Content="打开"
                                        Click="OpenData_Click" />
                            </StackPanel>
                        </Grid>

                        <TextBlock x:Name="DataHint" Margin="0,8,0,0" FontSize="11"
                                   Foreground="{StaticResource Brush.TextTertiary}" Text="" TextWrapping="Wrap" />

                        <Border Margin="0,14,0,0" Height="1" Background="{StaticResource Brush.Border}" />

                        <StackPanel Margin="0,12,0,0" Orientation="Horizontal">
                            <Button Style="{StaticResource Btn.Secondary.Small}" Content="导出配置副本" Click="Export_Click" />
                            <Button Margin="8,0,0,0" Style="{StaticResource Btn.Danger}" Content="清空启动器列表"
                                    Click="Clear_Click" />
                            <Button Margin="8,0,0,0" Style="{StaticResource Btn.Ghost}" Content="恢复默认设置"
                                    Click="ResetSettings_Click" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <TextBlock Margin="2,14,0,20" FontSize="11" TextWrapping="Wrap"
                           Foreground="{StaticResource Brush.TextTertiary}"
                           Text="提示：把 portable.txt 放在程序旁边，数据就会存在程序目录里，换台电脑也能带走。" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
