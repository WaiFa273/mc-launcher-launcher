<UserControl x:Class="LauncherLauncher.Views.ReportPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="26,22,26,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  标题  -->
        <Grid Grid.Row="0">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Text.H1}" Text="启动器体检" />
                    <Border Margin="10,0,0,0" Padding="8,2" VerticalAlignment="Center" CornerRadius="6"
                            Background="{StaticResource Brush.WarnSoft}">
                        <TextBlock FontSize="11" Foreground="{StaticResource Brush.Warn}" Text="门诊部" />
                    </Border>
                </StackPanel>
                <TextBlock x:Name="SubtitleText" Margin="0,6,0,0" Style="{StaticResource Text.Secondary}"
                           Text="根据你收藏的启动器，出一份严肃的体检报告。" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                <Button Style="{StaticResource Btn.Secondary}" Content="复制报告" Click="Copy_Click" />
                <Button Margin="8,0,0,0" Style="{StaticResource Btn.Primary}" Content="重新体检" Click="Recheck_Click" />
            </StackPanel>
        </Grid>

        <!--  分数 + 指标  -->
        <Grid Grid.Row="1" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="286" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="18,16">
                <StackPanel>
                    <TextBlock Style="{StaticResource Text.Caption}" Text="启动器健康指数" />

                    <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                        <TextBlock x:Name="ScoreText" FontSize="52" FontWeight="SemiBold" Text="0"
                                   Foreground="{Binding Score, Converter={StaticResource ScoreToBrush}}" />
                        <TextBlock Margin="4,0,0,10" VerticalAlignment="Bottom" FontSize="13"
                                   Foreground="{StaticResource Brush.TextTertiary}" Text="/ 100" />
                    </StackPanel>

                    <Border Margin="0,4,0,0" Padding="8,3" HorizontalAlignment="Left" CornerRadius="6"
                            Background="{StaticResource Brush.Muted}">
                        <TextBlock x:Name="ScoreTitleText" FontSize="11.5" FontWeight="SemiBold"
                                   Foreground="{StaticResource Brush.TextSecondary}" Text="待体检" />
                    </Border>

                    <TextBlock x:Name="ScoreCommentText" Margin="0,10,0,0" FontSize="12" LineHeight="20" TextWrapping="Wrap"
                               Foreground="{StaticResource Brush.TextSecondary}" Text="" />

                    <Border Margin="0,14,0,0" Height="1" Background="{StaticResource Brush.Border}" />

                    <StackPanel Margin="0,12,0,0">
                        <TextBlock x:Name="ReportNoText" FontSize="11" FontFamily="{StaticResource Font.Mono}"
                                   Foreground="{StaticResource Brush.TextTertiary}" Text="" />
                        <TextBlock x:Name="StampText" Margin="0,4,0,0" FontSize="11"
                                   Foreground="{StaticResource Brush.TextTertiary}" Text="" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="18,16">
                <StackPanel>
                    <TextBlock x:Name="HeadlineText" FontSize="13.5" FontWeight="SemiBold" TextWrapping="Wrap" Text="" />

                    <ItemsControl x:Name="MetricList" Margin="0,12,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="2" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,10,12">
                                    <StackPanel>
                                        <TextBlock FontSize="11" Text="{Binding Label}"
                                                   Foreground="{StaticResource Brush.TextTertiary}" />
                                        <TextBlock Margin="0,3,0,0" FontSize="16" FontWeight="SemiBold" Text="{Binding Value}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Margin="0,2,0,0" FontSize="10.5" Text="{Binding Hint}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{StaticResource Brush.TextTertiary}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Grid>

        <!--  诊断  -->
        <Border Grid.Row="2" Margin="0,14,0,0" Style="{StaticResource Card}" Padding="18,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal">
                    <TextBlock FontSize="14" FontWeight="SemiBold" Text="医师意见" />
                    <TextBlock Margin="8,2,0,0" FontSize="11" VerticalAlignment="Center"
                               Foreground="{StaticResource Brush.TextTertiary}" Text="不构成任何医疗建议，也不构成任何建议" />
                </StackPanel>

                <ScrollViewer Grid.Row="1" Margin="0,12,0,0" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="DiagnosisList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,8" Padding="12,10" CornerRadius="8"
                                        Background="{StaticResource Brush.Muted}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="3" CornerRadius="2" Background="{StaticResource Brush.Accent}" />
                                        <TextBlock Grid.Column="1" Margin="11,0,0,0" FontSize="12.5" LineHeight="21"
                                                   TextWrapping="Wrap" Text="{Binding}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <TextBlock x:Name="EmptyHint" Grid.Row="1" Text="列表里还没有启动器，体检结果只能靠想象。"
                           VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="12"
                           Foreground="{StaticResource Brush.TextTertiary}" Visibility="Collapsed" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
