<UserControl x:Class="LauncherLauncher.Views.AboutPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="26,22,26,18">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="660" HorizontalAlignment="Center">

                <StackPanel Orientation="Horizontal">
                    <Image Width="64" Height="64" RenderOptions.BitmapScalingMode="HighQuality"
                           Source="pack://application:,,,/Assets/app-256-preview.png" />
                    <StackPanel Margin="16,2,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Text.H1}" Text="启动器启动器" />
                            <Border Margin="10,0,0,0" Padding="8,2" VerticalAlignment="Center" CornerRadius="6"
                                    Background="{StaticResource Brush.AccentSoft}">
                                <TextBlock x:Name="VersionText" FontSize="11" Foreground="{StaticResource Brush.Accent}"
                                           Text="v0.1.0" />
                            </Border>
                        </StackPanel>
                        <TextBlock Margin="0,6,0,0" FontSize="12.5" Foreground="{StaticResource Brush.TextSecondary}"
                                   Text="一个专门用来启动启动器的启动器。" />
                    </StackPanel>
                </StackPanel>

                <Border Margin="0,18,0,0" Style="{StaticResource Card}" Padding="18,16">
                    <StackPanel>
                        <TextBlock FontSize="14" FontWeight="SemiBold" Text="它为什么会存在" />
                        <TextBlock Margin="0,10,0,0" FontSize="12.5" LineHeight="22" TextWrapping="Wrap"
                                   Foreground="{StaticResource Brush.TextSecondary}"
                                   Text="总有人热衷于给 Minecraft 开发启动器，于是硬盘里出现了一大堆没什么用但确实存在的启动器。它们各自占着一个文件夹，各自觉得自己很重要，各自需要你记住它在哪里。" />
                        <TextBlock Margin="0,8,0,0" FontSize="12.5" LineHeight="22" TextWrapping="Wrap"
                                   Foreground="{StaticResource Brush.TextSecondary}"
                                   Text="这个软件解决不了这个问题，但它至少能让你在一个地方看到全部的它们，然后一键把它们全部叫起来。这是一种非常现代的整理方式：不整理，只是集中管理混乱。" />
                        <TextBlock Margin="0,8,0,0" FontSize="12.5" LineHeight="22" TextWrapping="Wrap"
                                   Foreground="{StaticResource Brush.TextSecondary}"
                                   Text="顺便一提，它自己也是一个启动器。这一点它并不打算反省。" />
                    <TextBlock Margin="0,10,0,0" Style="{StaticResource Text.Caption}"
                               Foreground="{StaticResource Brush.Danger}"
                               Text="至于它怎么启动自己：首页右上角那个红色的按钮。真的别点。" />
                    </StackPanel>
                </Border>

                <Border Margin="0,12,0,0" Style="{StaticResource Card}" Padding="18,16">
                    <StackPanel>
                        <TextBlock FontSize="14" FontWeight="SemiBold" Text="现状" />
                        <StackPanel Margin="0,12,0,0" Orientation="Horizontal">
                            <StackPanel Width="150">
                                <TextBlock x:Name="StatLaunchers" FontSize="22" FontWeight="SemiBold" Text="0" />
                                <TextBlock Margin="0,2,0,0" FontSize="11" Text="个启动器被收录"
                                           Foreground="{StaticResource Brush.TextTertiary}" />
                            </StackPanel>
                            <StackPanel Width="150">
                                <TextBlock x:Name="StatLaunches" FontSize="22" FontWeight="SemiBold" Text="0" />
                                <TextBlock Margin="0,2,0,0" FontSize="11" Text="次启动被记录"
                                           Foreground="{StaticResource Brush.TextTertiary}" />
                            </StackPanel>
                            <StackPanel Width="150">
                                <TextBlock x:Name="StatSize" FontSize="22" FontWeight="SemiBold" Text="0 MB" />
                                <TextBlock Margin="0,2,0,0" FontSize="11" Text="本软件占用的体积"
                                           Foreground="{StaticResource Brush.TextTertiary}" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Margin="0,12,0,0" Style="{StaticResource Card}" Padding="18,16">
                    <StackPanel>
                        <TextBlock FontSize="14" FontWeight="SemiBold" Text="技术栈" />
                        <TextBlock x:Name="StackText" Margin="0,10,0,0" FontSize="12.5" LineHeight="22" TextWrapping="Wrap"
                                   Foreground="{StaticResource Brush.TextSecondary}" Text="" />
                        <TextBlock Margin="0,8,0,0" FontSize="12.5" LineHeight="22" TextWrapping="Wrap"
                                   Foreground="{StaticResource Brush.TextSecondary}"
                                   Text="没有用 Electron，不是因为它不好，而是因为这个玩笑不需要 120 MB 的诚意。" />
                    </StackPanel>
                </Border>

                <Border Margin="0,12,0,0" Style="{StaticResource Card}" Padding="18,16">
                    <StackPanel>
                        <TextBlock FontSize="14" FontWeight="SemiBold" Text="鸣谢" />
                        <TextBlock Margin="0,10,0,0" FontSize="12.5" LineHeight="22" TextWrapping="Wrap"
                                   Foreground="{StaticResource Brush.TextSecondary}"
                                   Text="感谢 Plain Craft Launcher 证明了 WPF 也能做出好用的启动器；感谢 HMCL、BakaXL、XMCL、Prism Launcher、MultiMC 以及所有叫得出和叫不出名字的启动器，为这个玩笑提供了素材。" />
                        <TextBlock Margin="0,8,0,0" FontSize="12.5" LineHeight="22" TextWrapping="Wrap"
                                   Foreground="{StaticResource Brush.TextSecondary}"
                                   Text="特别感谢每一位下载了多个启动器、最后只用其中一个的人。这个软件是为你们写的。" />
                    </StackPanel>
                </Border>

                <StackPanel Margin="0,14,0,24" Orientation="Horizontal">
                    <Button Style="{StaticResource Btn.Secondary}" Content="打开数据目录" Click="OpenData_Click" />
                    <Button Margin="8,0,0,0" Style="{StaticResource Btn.Ghost}" Content="复制版本信息"
                            Click="CopyVersion_Click" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
