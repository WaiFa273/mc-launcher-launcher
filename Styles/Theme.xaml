<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- ============================== 调色板 ============================== -->
    <SolidColorBrush x:Key="Brush.Window"        Color="#F3F5F9" />
    <SolidColorBrush x:Key="Brush.Sidebar"       Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.Card"          Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.Border"        Color="#E4E8F0" />
    <SolidColorBrush x:Key="Brush.BorderStrong"  Color="#C9D5EA" />
    <SolidColorBrush x:Key="Brush.Muted"         Color="#F1F4F9" />
    <SolidColorBrush x:Key="Brush.MutedHover"    Color="#E8EDF7" />
    <SolidColorBrush x:Key="Brush.Text"          Color="#171B26" />
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="#5B6472" />
    <SolidColorBrush x:Key="Brush.TextTertiary"  Color="#98A1B0" />
    <SolidColorBrush x:Key="Brush.Accent"        Color="#2E6BFF" />
    <SolidColorBrush x:Key="Brush.AccentHover"   Color="#3F78FF" />
    <SolidColorBrush x:Key="Brush.AccentPressed" Color="#1E54D8" />
    <SolidColorBrush x:Key="Brush.AccentSoft"    Color="#EAF0FF" />
    <SolidColorBrush x:Key="Brush.AccentSoft2"   Color="#DCE7FF" />
    <SolidColorBrush x:Key="Brush.Danger"        Color="#E5484D" />
    <SolidColorBrush x:Key="Brush.DangerSoft"    Color="#FDECEC" />
    <SolidColorBrush x:Key="Brush.Success"       Color="#12996B" />
    <SolidColorBrush x:Key="Brush.SuccessSoft"   Color="#E7F7F0" />
    <SolidColorBrush x:Key="Brush.Warn"          Color="#C4761A" />
    <SolidColorBrush x:Key="Brush.WarnSoft"      Color="#FDF3E4" />
    <SolidColorBrush x:Key="Brush.Overlay"       Color="#7A0B1220" />

    <FontFamily x:Key="Font.App">Microsoft YaHei UI, Microsoft YaHei, Segoe UI, SimSun</FontFamily>
    <FontFamily x:Key="Font.Icons">Segoe MDL2 Assets</FontFamily>
    <FontFamily x:Key="Font.Mono">Cascadia Mono, Consolas, Microsoft YaHei UI</FontFamily>

    <DropShadowEffect x:Key="Shadow.Card"  BlurRadius="18" ShadowDepth="0" Opacity="0.07" Color="#16233F" />
    <DropShadowEffect x:Key="Shadow.Popup" BlurRadius="26" ShadowDepth="2" Opacity="0.16" Color="#0B1220" />

    <!-- ============================== 文字 ============================== -->
    <!-- 不设 FontFamily：让 TextBlock 从父级继承，这样按钮里的图标字形不会被中文字体顶掉。 -->
    <Style TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="Text.H1" TargetType="TextBlock">
        <Setter Property="FontSize" Value="23" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
    </Style>

    <Style x:Key="Text.H2" TargetType="TextBlock">
        <Setter Property="FontSize" Value="16.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
    </Style>

    <Style x:Key="Text.H3" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
    </Style>

    <Style x:Key="Text.Body" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="LineHeight" Value="21" />
    </Style>

    <Style x:Key="Text.Secondary" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}" />
    </Style>

    <Style x:Key="Text.Caption" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextTertiary}" />
    </Style>

    <Style x:Key="Text.Icon" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Icons}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
    </Style>

    <!-- ============================== 卡片 / 徽章 ============================== -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Brush.Card}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="Card.Flat" TargetType="Border" BasedOn="{StaticResource Card}">
        <Setter Property="Effect" Value="{x:Null}" />
    </Style>

    <Style x:Key="Chip" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Brush.Muted}" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="7,2,7,3" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="Chip.Accent" TargetType="Border" BasedOn="{StaticResource Chip}">
        <Setter Property="Background" Value="{StaticResource Brush.AccentSoft}" />
    </Style>

    <Style x:Key="Chip.Warn" TargetType="Border" BasedOn="{StaticResource Chip}">
        <Setter Property="Background" Value="{StaticResource Brush.WarnSoft}" />
    </Style>

    <Style x:Key="Chip.Danger" TargetType="Border" BasedOn="{StaticResource Chip}">
        <Setter Property="Background" Value="{StaticResource Brush.DangerSoft}" />
    </Style>

    <Style x:Key="Chip.Success" TargetType="Border" BasedOn="{StaticResource Chip}">
        <Setter Property="Background" Value="{StaticResource Brush.SuccessSoft}" />
    </Style>

    <!-- ============================== 按钮模板 ============================== -->
    <ControlTemplate x:Key="Tpl.Button" TargetType="ButtonBase">
        <Grid>
            <Border x:Name="bd" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="9" SnapsToDevicePixels="True" />
            <Border x:Name="shade" Background="#000000" CornerRadius="9" Opacity="0" IsHitTestVisible="False" />
            <ContentPresenter x:Name="cp" Margin="{TemplateBinding Padding}"
                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                              RecognizesAccessKey="True" />
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="shade" Property="Opacity" Value="0.06" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="shade" Property="Opacity" Value="0.12" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="cp" Property="Opacity" Value="0.4" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <ControlTemplate x:Key="Tpl.Button.Small" TargetType="ButtonBase">
        <Grid>
            <Border x:Name="bd" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="8" SnapsToDevicePixels="True" />
            <Border x:Name="shade" Background="#000000" CornerRadius="8" Opacity="0" IsHitTestVisible="False" />
            <ContentPresenter Margin="{TemplateBinding Padding}"
                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                              RecognizesAccessKey="True" />
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="shade" Property="Opacity" Value="0.06" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="shade" Property="Opacity" Value="0.12" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="bd" Property="Opacity" Value="0.45" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <ControlTemplate x:Key="Tpl.Button.Icon" TargetType="ButtonBase">
        <Grid>
            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8" />
            <Border x:Name="shade" Background="#000000" CornerRadius="8" Opacity="0" IsHitTestVisible="False" />
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="shade" Property="Opacity" Value="0.06" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="shade" Property="Opacity" Value="0.12" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="Btn" TargetType="Button">
        <Setter Property="Height" Value="34" />
        <Setter Property="Padding" Value="15,0" />
        <Setter Property="FontFamily" Value="{StaticResource Font.App}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Background" Value="{StaticResource Brush.Muted}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template" Value="{StaticResource Tpl.Button}" />
    </Style>

    <Style x:Key="Btn.Primary" TargetType="Button" BasedOn="{StaticResource Btn}">
        <Setter Property="Background" Value="{StaticResource Brush.Accent}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
        <Setter Property="Foreground" Value="White" />
    </Style>

    <Style x:Key="Btn.Secondary" TargetType="Button" BasedOn="{StaticResource Btn}">
        <Setter Property="Background" Value="{StaticResource Brush.Card}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
    </Style>

    <Style x:Key="Btn.Ghost" TargetType="Button" BasedOn="{StaticResource Btn}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}" />
        <Setter Property="FontWeight" Value="Normal" />
    </Style>

    <Style x:Key="Btn.Danger" TargetType="Button" BasedOn="{StaticResource Btn}">
        <Setter Property="Background" Value="{StaticResource Brush.DangerSoft}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.DangerSoft}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Danger}" />
    </Style>

    <Style x:Key="Btn.Small" TargetType="Button" BasedOn="{StaticResource Btn}">
        <Setter Property="Height" Value="29" />
        <Setter Property="Padding" Value="11,0" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Template" Value="{StaticResource Tpl.Button.Small}" />
    </Style>

    <Style x:Key="Btn.Primary.Small" TargetType="Button" BasedOn="{StaticResource Btn.Small}">
        <Setter Property="Background" Value="{StaticResource Brush.Accent}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
        <Setter Property="Foreground" Value="White" />
    </Style>

    <Style x:Key="Btn.Secondary.Small" TargetType="Button" BasedOn="{StaticResource Btn.Small}">
        <Setter Property="Background" Value="{StaticResource Brush.Card}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
    </Style>

    <Style x:Key="Btn.Icon" TargetType="Button">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template" Value="{StaticResource Tpl.Button.Icon}" />
    </Style>

    <Style x:Key="Btn.TitleBar" TargetType="Button" BasedOn="{StaticResource Btn.Icon}">
        <Setter Property="Width" Value="46" />
        <Setter Property="Height" Value="44" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonBase">
                    <Grid>
                        <Border x:Name="bd" Background="Transparent" />
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#14000000" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#22000000" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Btn.Close" TargetType="Button" BasedOn="{StaticResource Btn.TitleBar}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonBase">
                    <Grid>
                        <Border x:Name="bd" Background="Transparent" />
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#E81123" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#C50F1F" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================== 侧栏导航 ============================== -->
    <Style x:Key="Nav" TargetType="RadioButton">
        <Setter Property="Height" Value="40" />
        <Setter Property="Margin" Value="10,1" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}" />
        <Setter Property="FontFamily" Value="{StaticResource Font.App}" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid>
                        <Border x:Name="bd" Background="Transparent" CornerRadius="9" />
                        <Grid Margin="12,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="22" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="ic" Grid.Column="0" FontFamily="{StaticResource Font.Icons}"
                                       FontSize="15" VerticalAlignment="Center" HorizontalAlignment="Left"
                                       Text="{TemplateBinding Tag}" Foreground="{TemplateBinding Foreground}" />
                            <ContentPresenter Grid.Column="1" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" />
                            <TextBlock x:Name="badge" Grid.Column="2" FontSize="11.5" Foreground="{StaticResource Brush.TextTertiary}"
                                       VerticalAlignment="Center" Text="{TemplateBinding ToolTip}" />
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource Brush.Muted}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource Brush.AccentSoft}" />
                            <Setter TargetName="ic" Property="Foreground" Value="{StaticResource Brush.Accent}" />
                            <Setter Property="Foreground" Value="{StaticResource Brush.Accent}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================== 分段选择（模式切换） ============================== -->
    <Style x:Key="Seg" TargetType="RadioButton">
        <Setter Property="Height" Value="28" />
        <Setter Property="Padding" Value="13,0" />
        <Setter Property="Margin" Value="2" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="bd" Background="Transparent" CornerRadius="7" Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#12000000" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource Brush.Card}" />
                            <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Setter TargetName="bd" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.12" Color="#16233F" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================== 输入框 ============================== -->
    <Style x:Key="Input" TargetType="TextBox">
        <Setter Property="Height" Value="36" />
        <Setter Property="Padding" Value="11,0" />
        <Setter Property="FontFamily" Value="{StaticResource Font.App}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
        <Setter Property="Background" Value="{StaticResource Brush.Card}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CaretBrush" Value="{StaticResource Brush.Accent}" />
        <Setter Property="SelectionBrush" Value="{StaticResource Brush.AccentSoft2}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="9" SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
                            <Setter TargetName="bd" Property="BorderThickness" Value="1.4" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Brush.BorderStrong}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================== 复选框 ============================== -->
    <Style x:Key="Check" TargetType="CheckBox">
        <Setter Property="FontFamily" Value="{StaticResource Font.App}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="box" Grid.Column="0" Width="18" Height="18" CornerRadius="5"
                                BorderThickness="1.4" BorderBrush="{StaticResource Brush.BorderStrong}"
                                Background="White" VerticalAlignment="Center">
                            <TextBlock x:Name="mark" FontFamily="{StaticResource Font.Icons}" Text="&#xE73E;"
                                       FontSize="10" Foreground="White" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" Visibility="Collapsed" />
                        </Border>
                        <ContentPresenter Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="box" Property="Background" Value="{StaticResource Brush.Accent}" />
                            <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
                            <Setter TargetName="mark" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================== 滚动条 ============================== -->
    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="10" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent" Margin="1,2">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" />
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" />
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border x:Name="tb" Background="#C6CFDF" CornerRadius="4" Margin="2,0" />
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="tb" Property="Background" Value="#A9B5CA" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ScrollViewer.Clean" TargetType="ScrollViewer">
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="CanContentScroll" Value="False" />
    </Style>

    <!-- ============================== 右键菜单 ============================== -->
    <Style TargetType="ContextMenu">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Background="{StaticResource Brush.Card}" CornerRadius="10" Padding="4"
                            BorderBrush="{StaticResource Brush.Border}" BorderThickness="1"
                            Effect="{StaticResource Shadow.Popup}">
                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="MenuItem">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="FontFamily" Value="{StaticResource Font.App}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="bd" Background="Transparent" CornerRadius="6" Padding="10,6" Margin="1,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="22" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ContentPresenter Grid.Column="0" Content="{TemplateBinding Icon}" VerticalAlignment="Center" />
                            <ContentPresenter Grid.Column="1" ContentSource="Header" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                            <TextBlock Grid.Column="2" Text="{TemplateBinding InputGestureText}" FontSize="11"
                                       Foreground="{StaticResource Brush.TextTertiary}" VerticalAlignment="Center"
                                       Margin="16,0,2,0" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource Brush.Muted}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Separator">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Height="1" Margin="8,4" Background="{StaticResource Brush.Border}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================== 提示气泡 ============================== -->
    <Style TargetType="ToolTip">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="#F20B1220" CornerRadius="7" Padding="9,5">
                        <ContentPresenter TextElement.Foreground="White" TextElement.FontSize="11.5"
                                          TextElement.FontFamily="{StaticResource Font.App}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="HasDropShadow" Value="False" />
    </Style>

</ResourceDictionary>
