<Window x:Class="LauncherLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="启动器启动器"
        Width="1100" Height="740" MinWidth="940" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize"
        Background="{StaticResource Brush.Window}"
        FontFamily="{StaticResource Font.App}" FontSize="13"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        AllowDrop="True" DragOver="Window_DragOver" Drop="Window_Drop"
        PreviewKeyDown="Window_PreviewKeyDown">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="46"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="46" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  标题栏  -->
        <Grid Grid.Row="0" Background="{StaticResource Brush.Sidebar}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="16,0,0,0" Orientation="Horizontal" VerticalAlignment="Center">
                <Image x:Name="TitleIcon" Width="18" Height="18" RenderOptions.BitmapScalingMode="HighQuality" />
                <TextBlock Margin="9,0,0,0" VerticalAlignment="Center"
                           FontSize="13" FontWeight="SemiBold" Text="启动器启动器" />
                <Border Margin="10,0,0,0" Padding="7,2" VerticalAlignment="Center"
                        Background="{StaticResource Brush.Muted}" BorderThickness="0" CornerRadius="5">
                    <TextBlock x:Name="VersionChip" FontSize="10.5"
                               Foreground="{StaticResource Brush.TextTertiary}" Text="套娃版 v0.1.0" />
                </Border>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Button x:Name="MinBtn" Style="{StaticResource Btn.TitleBar}" Click="Min_Click"
                        Content="&#xE921;" FontFamily="{StaticResource Font.Icons}" FontSize="10" ToolTip="最小化" />
                <Button x:Name="MaxBtn" Style="{StaticResource Btn.TitleBar}" Click="Max_Click"
                        Content="&#xE922;" FontFamily="{StaticResource Font.Icons}" FontSize="10" ToolTip="最大化" />
                <Button Style="{StaticResource Btn.Close}" Click="Close_Click"
                        Content="&#xE8BB;" FontFamily="{StaticResource Font.Icons}" FontSize="10" ToolTip="关闭" />
            </StackPanel>

            <Border Grid.ColumnSpan="3" VerticalAlignment="Bottom" Height="1"
                    Background="{StaticResource Brush.Border}" />
        </Grid>

        <!--  主体  -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="216" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  侧栏  -->
            <Border Grid.Column="0" Background="{StaticResource Brush.Sidebar}"
                    BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,1,0">
                <DockPanel LastChildFill="False">
                    <StackPanel DockPanel.Dock="Top" Margin="12,14,12,0">
                        <TextBlock Margin="10,0,0,7" Style="{StaticResource Text.Caption}" Text="启动器们" />
                        <RadioButton x:Name="NavHome" Style="{StaticResource Nav}" Content="启动器列表" Tag="&#xE7FC;"
                                     IsChecked="True" Checked="Nav_Checked" />
                        <RadioButton x:Name="NavChain" Style="{StaticResource Nav}" Content="启动器接力" Tag="&#xE71B;"
                                     Checked="Nav_Checked" />
                        <TextBlock Margin="10,14,0,7" Style="{StaticResource Text.Caption}" Text="自我反省" />
                        <RadioButton x:Name="NavReport" Style="{StaticResource Nav}" Content="启动器体检" Tag="&#xE9D9;"
                                     Checked="Nav_Checked" />
                        <TextBlock Margin="10,14,0,7" Style="{StaticResource Text.Caption}" Text="其他" />
                        <RadioButton x:Name="NavSettings" Style="{StaticResource Nav}" Content="设置" Tag="&#xE713;"
                                     Checked="Nav_Checked" />
                        <RadioButton x:Name="NavAbout" Style="{StaticResource Nav}" Content="关于" Tag="&#xE946;"
                                     Checked="Nav_Checked" />
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Bottom" Margin="12,0,12,12">
                        <Border Padding="10,9" Background="{StaticResource Brush.Muted}" CornerRadius="10">
                            <StackPanel>
                                <TextBlock x:Name="SidebarStat" FontSize="12.5" FontWeight="SemiBold" Text="0 个启动器" />
                                <TextBlock x:Name="SidebarHint" Margin="0,3,0,0" FontSize="11"
                                           Foreground="{StaticResource Brush.TextTertiary}" Text="还没有启动器" />
                                <TextBlock x:Name="SidebarSize" Margin="0,6,0,0" FontSize="10.5"
                                           Foreground="{StaticResource Brush.TextTertiary}" Text="本软件 v0.1.0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!--  页面区  -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="30" />
                </Grid.RowDefinitions>

                <ContentControl x:Name="PageHost" Grid.Row="0" />

                <Border Grid.Row="1" Background="{StaticResource Brush.Window}"
                        BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,1,0,0">
                    <Grid Margin="20,0,12,0">
                        <TextBlock x:Name="StatusText" VerticalAlignment="Center" FontSize="11.5"
                                   Foreground="{StaticResource Brush.TextTertiary}" />
                        <Button x:Name="DataDirBtn" HorizontalAlignment="Right" VerticalAlignment="Center"
                                Style="{StaticResource Btn.Ghost}" Height="24" Padding="7,0" FontSize="11"
                                Click="DataDir_Click" ToolTip="打开数据目录">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="{StaticResource Font.Icons}" FontSize="11" Text="&#xE8B7;" />
                                <TextBlock Margin="6,0,0,0" Text="数据目录" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!--  弹层  -->
        <Grid x:Name="OverlayLayer" Grid.RowSpan="2" Panel.ZIndex="50" Opacity="0" Visibility="Collapsed"
              Background="{StaticResource Brush.Overlay}" MouseLeftButtonDown="Overlay_MouseDown"
              shell:WindowChrome.IsHitTestVisibleInChrome="True">
            <Border x:Name="OverlayCard" Margin="60,40" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{StaticResource Brush.Card}" CornerRadius="16"
                    Effect="{StaticResource Shadow.Popup}">
                <ContentControl x:Name="OverlayContent" />
            </Border>
        </Grid>

        <!--  Toast  -->
        <StackPanel x:Name="ToastPanel" Grid.RowSpan="2" Panel.ZIndex="60" Margin="0,0,0,48"
                    HorizontalAlignment="Center" VerticalAlignment="Bottom" IsHitTestVisible="False" />
    </Grid>
</Window>
